# Private channel and the only human Slack member allowed to start jobs.
SLACK_CHANNEL_ID=C0000000000
SLACK_OWNER_USER_ID=U0000000000

# Only Goose-Codex connects through Socket Mode.
SLACK_CODEX_APP_TOKEN=xapp-replace-me
SLACK_CODEX_BOT_TOKEN=xoxb-replace-me
SLACK_CLAUDE_BOT_TOKEN=xoxb-replace-me

# Uses the local .tools/goose installation if present, otherwise searches PATH.
# GOOSE_BIN=C:/path/to/goose.exe
# STATE_DIR=.data
# GOOSE_WORK_DIR=C:/path/to/repo
# GOOSE_CODEX_MODEL=gpt-5.6-sol
# GOOSE_CLAUDE_MODEL=current
# GOOSE_CLAUDE_EFFORT=medium
# GOOSE_TURN_TIMEOUT_SECONDS=180
