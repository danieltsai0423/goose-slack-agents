{
  "name": "goose-slack-agents",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/main.mjs",
    "configure": "node --env-file-if-exists=.env src/setup.mjs configure",
    "smoke": "node --env-file-if-exists=.env src/setup.mjs smoke",
    "slack:setup": "node --env-file-if-exists=.env.slack-setup src/slack-setup.mjs",
    "test": "node --test"
  },
  "dependencies": {
    "@agentclientprotocol/claude-agent-acp": "0.109.0",
    "@slack/socket-mode": "3.2.0",
    "@slack/web-api": "8.5.0"
  }
}
